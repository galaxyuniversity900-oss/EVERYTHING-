{
  "name": "everything-platform",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "A lightweight browser workspace with local notes, multi-provider AI, MCP tools, and optional remote runtime sessions.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test",
    "start:worker": "node --env-file-if-exists=.env remote-worker/server.mjs"
  }
}
