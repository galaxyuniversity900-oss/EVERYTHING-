# Copy to remote-worker/.env. Never commit the real file.
# This worker controls a Docker daemon. Use only on a dedicated Linux host.
WORKER_TOKEN=SET_A_UNIQUE_RANDOM_TOKEN_OF_AT_LEAST_32_BYTES
WORKER_HOST=127.0.0.1
WORKER_PORT=8788
WORKER_PUBLIC_BASE_URL=https://runtime.example.com/
WORKER_SESSION_BASE_URL=https://sessions.example.com/
WORKER_MAX_SESSIONS=2
WORKER_SESSION_TTL_MINUTES=60
WORKER_IDLE_TIMEOUT_MINUTES=15

# Replace the image with a reviewed, pinned image before internet exposure.
WORKER_APPS_JSON='[{"id":"linux-desktop","name":"Linux Desktop (XFCE)","description":"Remote Linux desktop streamed to a browser; installed tools depend on the image.","image":"lscr.io/linuxserver/webtop:ubuntu-xfce","port":3000,"memory":"2g","cpus":1,"pids":256,"env":{"PUID":"1000","PGID":"1000","TZ":"Etc/UTC","CUSTOM_USER":"desktop","PASSWORD":"SET_A_LONG_RANDOM_CONTAINER_PASSWORD"}}]'
