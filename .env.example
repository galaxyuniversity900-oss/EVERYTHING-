# Copy to .env and set your own values. Never commit .env.
# AI is disabled unless AI_API_ENABLED=true.
AI_API_ENABLED=false

# Cloud OpenAI-compatible provider:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# For local Ollama or another compatible server on this same machine,
# set OPENAI_BASE_URL=http://127.0.0.1:11434/v1 and a model name above.
# Local loopback endpoints may omit OPENAI_API_KEY.

# Optional MCP Streamable HTTP server. Tool calls require user confirmation in the UI.
# Use HTTPS for non-local hosts. For a local server, HTTP is allowed.
# MCP_SERVER_URL=https://your-trusted-mcp-server.example/mcp
# MCP_ACCESS_TOKEN=

# Optional remote runtime worker; it must implement docs/remote-runtime-api.md.
# The adapter launches sessions but does not itself host or sandbox the worker.
# REMOTE_RUNTIME_URL=https://your-remote-worker.example/
# REMOTE_RUNTIME_TOKEN=

# Optional multi-provider mode: each profile references a server environment variable for its key.
# NVIDIA NIM is OpenAI-compatible; replace the model with one available to your account.
# AI_PROVIDERS_JSON='[{"id":"openai","name":"OpenAI","baseUrl":"https://api.openai.com/v1","model":"your-model","apiKeyEnv":"OPENAI_API_KEY","capabilities":["chat","coding"]},{"id":"nvidia","name":"NVIDIA NIM","baseUrl":"https://integrate.api.nvidia.com/v1","model":"your-nim-model-id","apiKeyEnv":"NVIDIA_API_KEY","capabilities":["chat","reasoning"]},{"id":"local","name":"Local model","baseUrl":"http://127.0.0.1:11434/v1","model":"your-local-model","capabilities":["chat"]}]'
# AI_DEFAULT_PROVIDER=openai
# AI_FALLBACK_ENABLED=false
# If AI_PROVIDERS_JSON is set, provider entries above replace the single-provider settings.
