# Copy to .env and set your own values. Never commit .env.
# AI is disabled unless AI_API_ENABLED=true.
AI_API_ENABLED=false

# Cloud OpenAI-compatible provider:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# For local Ollama or another compatible server on this same machine,
# set OPENAI_BASE_URL=http://127.0.0.1:11434/v1 and a model name above.
# Local loopback endpoints may omit OPENAI_API_KEY.

# Optional MCP Streamable HTTP server. Tool calls require user confirmation in the UI.
# Use HTTPS for non-local hosts. For a local server, HTTP is allowed.
# MCP_SERVER_URL=https://your-trusted-mcp-server.example/mcp
# MCP_ACCESS_TOKEN=

# Optional remote runtime worker; it must implement docs/remote-runtime-api.md.
# The adapter launches sessions but does not itself host or sandbox the worker.
# REMOTE_RUNTIME_URL=https://your-remote-worker.example/
# REMOTE_RUNTIME_TOKEN=

# Optional multi-provider mode: each profile references a server environment variable for its key.
# NVIDIA NIM is OpenAI-compatible; replace the model with one available to your account.
# AI_PROVIDERS_JSON='[{"id":"openai","name":"OpenAI-compatible","protocol":"openai-compatible","baseUrl":"https://api.openai.com/v1","model":"your-model","apiKeyEnv":"OPENAI_API_KEY","capabilities":["chat","coding"]},{"id":"nvidia","name":"NVIDIA NIM","protocol":"openai-compatible","baseUrl":"https://integrate.api.nvidia.com/v1","model":"your-nim-model-id","apiKeyEnv":"NVIDIA_API_KEY","capabilities":["chat","reasoning"]},{"id":"anthropic","name":"Anthropic","protocol":"anthropic","baseUrl":"https://api.anthropic.com/v1","model":"your-anthropic-model","apiKeyEnv":"ANTHROPIC_API_KEY","capabilities":["chat","reasoning"]},{"id":"gemini","name":"Google Gemini","protocol":"gemini","baseUrl":"https://generativelanguage.googleapis.com/v1beta","model":"your-gemini-model","apiKeyEnv":"GEMINI_API_KEY","capabilities":["chat","coding"]},{"id":"local","name":"Local model","protocol":"openai-compatible","baseUrl":"http://127.0.0.1:11434/v1","model":"your-local-model","capabilities":["chat"]}]'
# AI_DEFAULT_PROVIDER=openai
# NVIDIA_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AI_FALLBACK_ENABLED=false
# If AI_PROVIDERS_JSON is set, provider entries above replace the single-provider settings.

# Optional shared-password access gate. Leave AUTH_PASSWORD empty for localhost-only development.
# For a trusted public hostname, configure a strong password, COOKIE_SECURE=true,
# TRUSTED_HOSTS=app.example.com, and terminate HTTPS at a reverse proxy that sets X-Forwarded-Proto=https.
AUTH_PASSWORD=
COOKIE_SECURE=false
TRUSTED_HOSTS=

# Optional Docker-backed remote application worker (see remote-worker/README.md).
# Run only on a dedicated Docker host. WORKER_TOKEN and REMOTE_RUNTIME_TOKEN must match.
# WORKER_TOKEN=replace-with-a-random-64-character-hex-token
# WORKER_HOST=127.0.0.1
# WORKER_PORT=8788
# WORKER_PUBLIC_BASE_URL=https://runtime.example.com/
# WORKER_SESSION_BASE_URL=https://sessions.example.com/
# WORKER_APPS_JSON='[{"id":"linux-desktop","name":"Linux Desktop","image":"your-pinned-desktop-image:tag","port":3000,"memory":"2g","cpus":1,"pids":256}]'
# If both Node services run directly on the same host, the main app may use:
# REMOTE_RUNTIME_URL=http://127.0.0.1:8788/
# REMOTE_RUNTIME_TOKEN=the-same-value-as-WORKER_TOKEN
